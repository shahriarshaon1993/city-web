                "heading": "Mission, vision and values",
                "tabs": [
                    {
                        "label": "Mission",
                        "title": "Build what we promise, and show our work",
                        "text": "We deliver homes and workplaces that match their brochures: the area, the finishes and the date. Approvals, progress photos and inspection stages are published so buyers never have to chase us for the facts.",
                        "image": {
                            "demo": "interiors/interiors-01"
                        }
                    },
                    {
                        "label": "Vision",
                        "title": "The most trusted name in Bangladeshi property",
                        "text": "We want a Gemcon City address to be the safest way to buy property in the country, for families in Dhaka and for Bangladeshis living abroad.",
                        "image": {
                            "demo": "locations/locations-03"
                        }
                    },
                    {
                        "label": "Values",
                        "title": "Integrity, craft and care",
                        "text": "We put prices and terms in writing, specify materials for decades of use, and stay with each building long after handover. These three habits decide every choice we make.",
                        "image": {
                            "demo": "interiors/interiors-03"
                        }
                    }
